<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_form_status_indicator')]" position="replace">
            <div class="o_form_status_indicator d-flex align-items-center" t-att-class="{ o_form_status_indicator_new_record: props.model.root.isNew }">
            <div class="o_form_status_indicator_buttons d-flex" t-att-class="{ 'd-none': !(props.model.root.isNew or displayButtons) }">
                <button
                    type="button"
                    class="o_form_button_save btn btn-outline-primary me-1"
                    data-hotkey="s"
                    t-on-click.stop="save"
                    data-tooltip="Save manually"
                    aria-label="Save manually"
                    t-ref="save">
                    Save
                </button>
                <button
                    type="button"
                    class="o_form_button_cancel btn btn-outline-primary"
                    data-hotkey="j"
                    t-on-click.stop="discard"
                    data-tooltip="Discard changes"
                    aria-label="Discard changes">
                    Discard changes
                </button>
            </div>
            <span
                t-if="!props.model.root.isNew and indicatorMode === 'invalid'"
                class="text-danger small ms-2"
                data-tooltip="Unable to save. Correct the issue or discard changes">
                <i class="fa fa-warning" />
            </span>
        </div>
        </xpath>
    </t>

</templates>